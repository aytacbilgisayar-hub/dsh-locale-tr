{
  "name": "dsh-locale-tr",
  "version": "0.2.0",
  "description": "Turkish (Türkçe) language pack for DeepSeek Harness (dsh) — a client plugin that registers the 'tr' UI locale.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "src/translations.json",
    "src/client.js"
  ],
  "scripts": {
    "build": "node scripts/build.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./dsh.bundle.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "locale",
    "i18n",
    "l10n",
    "turkish",
    "turkce",
    "türkçe"
  ],
  "author": "Hasan Aytaç <aytacbilgisayar@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aytacbilgisayar-hub/dsh-locale-tr.git"
  },
  "homepage": "https://github.com/aytacbilgisayar-hub/dsh-locale-tr#readme",
  "bugs": {
    "url": "https://github.com/aytacbilgisayar-hub/dsh-locale-tr/issues"
  }
}
